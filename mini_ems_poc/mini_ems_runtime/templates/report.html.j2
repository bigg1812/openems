<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <title>{{ report.title }}</title>
  <style>
    @page { size: A4; margin: 14mm; }
    :root {
      --ink: #17212b;
      --muted: #657384;
      --line: #dbe4ee;
      --soft: #f6f8fb;
      --panel: #ffffff;
      --blue: #2563eb;
      --green: #16875a;
      --amber: #b7791f;
      --red: #bf3f36;
      --dark: #111b25;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: #eef3f7;
      color: var(--ink);
      font-family: "Segoe UI", Arial, sans-serif;
      font-size: 12px;
      line-height: 1.45;
    }
    .report-shell {
      width: min(1180px, 100%);
      margin: 0 auto;
      padding: 28px;
    }
    .report-cover {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      align-items: end;
      padding: 26px;
      border-radius: 8px;
      background: var(--dark);
      color: #ffffff;
    }
    .eyebrow {
      display: block;
      color: #9fb0c2;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    h1 {
      margin: 6px 0 0;
      font-size: 30px;
      font-weight: 680;
      letter-spacing: 0;
    }
    h2 {
      margin: 0 0 14px;
      font-size: 16px;
      letter-spacing: 0;
    }
    .subtitle {
      margin: 8px 0 0;
      color: #cad6e2;
    }
    .generated {
      text-align: right;
      color: #cad6e2;
    }
    .pipeline {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 18px;
    }
    .pipeline span {
      min-height: 26px;
      padding: 5px 9px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 8px;
      color: #edf4fb;
    }
    section {
      margin-top: 18px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--panel);
      page-break-inside: avoid;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 10px;
    }
    .card {
      min-height: 122px;
      padding: 14px;
      border: 1px solid var(--line);
      border-top: 3px solid var(--blue);
      border-radius: 8px;
      background: var(--soft);
      page-break-inside: avoid;
    }
    .card.energy {
      border-top-color: var(--green);
    }
    .card.state {
      border-top-color: var(--amber);
    }
    .card-title {
      display: block;
      margin-top: 7px;
      font-weight: 650;
    }
    .metric {
      display: block;
      margin-top: 10px;
      color: var(--ink);
      font-size: 23px;
      font-weight: 680;
      line-height: 1;
    }
    .metric small {
      color: var(--muted);
      font-size: 11px;
      font-weight: 500;
    }
    .meta {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 11px;
    }
    .chart-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .chart-card {
      padding: 14px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: #ffffff;
      page-break-inside: avoid;
    }
    .chart-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      color: var(--muted);
    }
    .chart {
      width: 100%;
      height: 152px;
      border: 1px solid var(--line);
      background: #fbfdff;
    }
    .empty {
      padding: 18px;
      border: 1px dashed var(--line);
      border-radius: 8px;
      color: var(--muted);
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th,
    td {
      border-bottom: 1px solid var(--line);
      padding: 8px 7px;
      text-align: left;
      font-size: 11px;
    }
    th {
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    td.value {
      font-weight: 650;
      text-align: right;
      white-space: nowrap;
    }
    .print-note {
      margin-top: 18px;
      color: var(--muted);
      font-size: 11px;
    }
    @media print {
      body { background: #ffffff; }
      .report-shell { width: 100%; padding: 0; }
      .report-cover, section { box-shadow: none; }
    }
    @media (max-width: 900px) {
      .report-shell { padding: 16px; }
      .report-cover, .cards, .chart-grid { grid-template-columns: 1fr; }
      .generated { text-align: left; }
    }
  </style>
</head>
<body>
  <main class="report-shell">
    <header class="report-cover">
      <div>
        <span class="eyebrow">Mini EMS Betriebsbericht</span>
        <h1>{{ report.title }}</h1>
        <p class="subtitle">{{ report.subtitle }}</p>
        <div class="pipeline">
          {% for step in report.export_pipeline %}
            <span>{{ step }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="generated">
        <span class="eyebrow">Erstellt</span>
        <strong>{{ report.generated_at }}</strong>
      </div>
    </header>

    {% for section in report.sections %}
      <section>
        <h2>{{ section.title }}</h2>
        {% if section.component == "summary" %}
          <div class="cards">
            {% for card in section.cards %}
              <article class="card {{ 'energy' if card.kind == 'energy_counter' else '' }} {{ 'state' if card.kind == 'state' else '' }}">
                <span class="eyebrow">{{ card.group }}</span>
                <span class="card-title">{{ card.label }}</span>
                <strong class="metric">
                  {{ "%.2f"|format(card.display_value) if card.display_value is not none else "-" }}
                  <small>{{ card.unit }}</small>
                </strong>
                <p class="meta">{{ card.display_label }} / {{ card.detail }}</p>
                <p class="meta">{{ card.sample_count }} Messpunkte</p>
              </article>
            {% endfor %}
          </div>
        {% elif section.component == "line_chart" %}
          <div class="chart-grid">
            {% for serie in section.series %}
              {% set points = serie.points | selectattr("value", "ne", none) | list %}
              <article class="chart-card">
                <div class="chart-head">
                  <strong>{{ serie.label }}</strong>
                  <span>{{ serie.unit }}</span>
                </div>
                {% if points %}
                  {% set values = points | map(attribute="value") | list %}
                  {% set min_value = values | min %}
                  {% set max_value = values | max %}
                  {% set span = max_value - min_value if max_value != min_value else 1 %}
                  {% set divisor = points|length - 1 if points|length > 1 else 1 %}
                  <svg class="chart" viewBox="0 0 520 150" preserveAspectRatio="none" role="img" aria-label="{{ serie.label }}">
                    <line x1="0" y1="132" x2="520" y2="132" stroke="#dbe4ee"></line>
                    <polyline
                      fill="none"
                      stroke="{{ '#16875a' if serie.unit == 'kWh' else '#2563eb' }}"
                      stroke-width="2.4"
                      points="{% for point in points %}{{ (loop.index0 / divisor * 520)|round(1) }},{{ (132 - (((point.value - min_value) / span) * 112))|round(1) }} {% endfor %}">
                    </polyline>
                  </svg>
                  <p class="meta">Min {{ "%.2f"|format(min_value) }} / Max {{ "%.2f"|format(max_value) }}</p>
                {% else %}
                  <div class="empty">Keine Daten im gewählten Zeitraum.</div>
                {% endif %}
              </article>
            {% endfor %}
          </div>
        {% elif section.component == "table" %}
          <table>
            <thead>
              <tr><th>Zeit</th><th>Datenpunkt</th><th>Wert</th><th>Einheit</th></tr>
            </thead>
            <tbody>
              {% for row in section.rows %}
                <tr>
                  <td>{{ row.timestamp }}</td>
                  <td>{{ row.label or "Datenpunkt" }}</td>
                  <td class="value">{{ "%.2f"|format(row.value) if row.value is not none else "-" }}</td>
                  <td>{{ row.unit }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <table>
            <thead>
              <tr><th>Zeit</th><th>Bereich</th><th>Status</th><th>Meldung</th></tr>
            </thead>
            <tbody>
              {% for row in section.rows %}
                <tr>
                  <td>{{ row.timestamp }}</td>
                  <td>{{ "Kommunikation" if row.channel_id else "Anlage" }}</td>
                  <td>{{ row.severity }}</td>
                  <td>{{ row.message or row.event_type }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}
      </section>
    {% endfor %}
    <p class="print-note">Hinweis: Wenn der direkte PDF-Renderer nicht installiert ist, kann diese HTML-Ansicht im Browser als PDF gedruckt werden.</p>
  </main>
</body>
</html>
